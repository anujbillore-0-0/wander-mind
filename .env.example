# Copy to .env and fill in. Every service below has a free tier.

# ---------------------------------------------------------------- LLMs
# Add at least ONE key. With several, Wander Mind rotates between them when one hits its limit.
# Cerebras: very fast, generous daily tokens   https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Groq                                         https://console.groq.com/keys
GROQ_API_KEY=
# Mistral (free "Experiment" plan)             https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Google AI Studio                             https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter free models                       https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: change the fallback order ("provider:model", comma-separated).
# PLANNER_MODELS=cerebras:gpt-oss-120b,groq:openai/gpt-oss-120b,mistral:mistral-large-latest,gemini:gemini-flash-lite-latest
# EXTRACT_MODELS=mistral:mistral-small-latest,groq:openai/gpt-oss-20b,cerebras:gpt-oss-120b

# ---------------------------------------------------------------- Optional evidence sources
# YouTube Data API v3: better search + vlog comments (10,000 free units/day)
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Reddit: only works after Reddit approves a Data Access Request (Responsible Builder Policy, 2-4 weeks,
# needs a public product URL, often refused). Leave empty otherwise - Reddit is then skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Wikimedia and Reddit require a user agent with a contact URL or email.
USER_AGENT=WanderMind/0.1 (https://github.com/your-name/wander-mind; you@example.com)

# ---------------------------------------------------------------- Research volume
# More = richer evidence but more LLM tokens per new destination.
RESEARCH_VIDEOS_PER_TOPIC=2
RESEARCH_PAGES_PER_TOPIC=2
RESEARCH_THREADS_PER_TOPIC=1
RESEARCH_MAX_LLM_CHUNKS=20
RESEARCH_REFRESH_DAYS=21

# Background worker: extra destinations to pre-research (it always refreshes places you've planned).
# Leave empty on a single free key - pre-research shares the quota with live planning.
SEED_DESTINATIONS=
WORKER_INTERVAL_HOURS=24

# ---------------------------------------------------------------- Docker
SEARXNG_SECRET=change-me-to-a-long-random-string
# Where the browser reaches the API (change if you expose the app beyond localhost).
PUBLIC_API_URL=http://localhost:8000
